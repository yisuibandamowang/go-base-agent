# .env.example — ragent-go
# 复制为 .env 后填入你的实际值，.env 不提交到 git。
# 生产环境请使用配置中心 / K8s Secret / Vault，不要依赖 .env 文件。

# PostgreSQL + pgvector
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ragent

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# RocketMQ
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# Milvus（可选，默认用 pgvector）
MILVUS_URI=http://localhost:19530

# RustFS（S3 兼容对象存储）
RUSTFS_URL=http://localhost:9000
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=

# MCP Server
MCP_SERVER_URL=http://localhost:9099

# Ollama（本地模型）
OLLAMA_URL=http://localhost:11434

# 阿里云百炼
BAILIAN_API_KEY=

# SiliconFlow
SILICONFLOW_API_KEY=
